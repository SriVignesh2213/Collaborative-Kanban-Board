# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanban?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT Secret Keys
JWT_ACCESS_SECRET="generate_a_very_long_secure_random_key_here"
JWT_REFRESH_SECRET="generate_another_very_long_secure_random_key_here"

# Cloudinary Storage (Optional - Fallback base64 enabled if missing)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Frontend URL
FRONTEND_URL="http://localhost:5173"
